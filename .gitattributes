# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.php text
*.xml text
*.xlf text
*.yaml text
*.yml text
*.json text
*.js text
*.css text
*.scss text
*.html text
*.sql text
*.md text
*.rst text
*.txt text

# Shell scripts
*.sh text eol=lf

# Exclude development files from git archive: the GitHub release archives and
# the Composer dist downloads from GitHub. TER packaging (tailor) zips the
# working directory and does not read this file; Build/ExcludeFromPackaging.php
# is its list.
/Tests export-ignore
/Build export-ignore
/.github export-ignore
/.ddev export-ignore
/docs export-ignore
/scripts export-ignore
/.bestpractices.json export-ignore
/codecov.yml export-ignore
/Documentation/index.html export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/phpstatus export-ignore
/renovate.json export-ignore
/Makefile export-ignore
/README.md export-ignore
/claudedocs export-ignore
/composer.lock export-ignore
/.php-cs-fixer.cache export-ignore
/DDEV_SETUP.md export-ignore
/crowdin.yml export-ignore
/index.html export-ignore

# Agent instructions, at every level of the tree.
AGENTS.md export-ignore
CLAUDE.md export-ignore

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
