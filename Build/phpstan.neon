# phpstan/extension-installer is disabled in composer.json, because
# netresearch/typo3-ci-workflows drags in ergebnis/phpstan-rules and
# phpstan-strict-rules, whose auto-registration lands 185 uncurated findings
# on this level-max baseline. Adopting those rule sets is its own migration.
# The two extensions this project did analyse with before are registered by
# hand here, so the disabled installer costs no TYPO3 rule coverage.
includes:
    - ../.Build/vendor/saschaegerer/phpstan-typo3/extension.neon
    - ../.Build/vendor/bnf/phpstan-psr-container/extension.neon

parameters:
    level: max
    paths:
        - ../Classes
    excludePaths:
        - ../.Build/*
    bootstrapFiles:
        - ../.Build/vendor/autoload.php
        - ../Tests/Unit/Bootstrap.php
    scanDirectories:
        - ../Tests/Unit/Fixtures
    # PHPDoc is not evidence: without this, level max trusts an annotation over
    # what the code can actually hold at runtime.
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # All three entries below cover ONE expression, the version-safe icon
        # size in Classes/Controller/Backend/TemporalCacheController.php:
        # class_exists(IconSize::class) ? IconSize::SMALL : Icon::SIZE_SMALL.
        # One half of that ternary is always wrong for the TYPO3 version the
        # matrix cell installed, and which half decides which entry fires — so
        # each carries reportUnmatched: false. reportUnmatchedIgnoredErrors
        # itself stays at its default (true), so an ignore that is stale rather
        # than version-conditional is still reported. Drop the lot when v12
        # support is dropped and the ternary goes.
        # The IconSize enum does not exist on every supported version.
        -
            identifier: class.notFound
            message: '#class TYPO3\\CMS\\Core\\Imaging\\IconSize#'
            reportUnmatched: false
        # Icon::SIZE_SMALL is gone on v14 (verified: Imaging/Icon.php in
        # cms-core 14.3 declares no SIZE_* constant) and present on v12.
        -
            identifier: classConstant.notFound
            message: '#Icon::SIZE_SMALL#'
            reportUnmatched: false
        # IconFactory::getIcon() takes an IconSize on the versions that have the
        # enum, so the v12 fallback branch is the wrong argument type there.
        -
            identifier: argument.type
            message: '#method TYPO3\\CMS\\Core\\Imaging\\IconFactory::getIcon\(\) expects TYPO3\\CMS\\Core\\Imaging\\IconSize#'
            reportUnmatched: false
