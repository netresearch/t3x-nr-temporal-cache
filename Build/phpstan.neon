# The shared config of netresearch/typo3-ci-workflows sets level 10,
# treatPhpDocTypesAsCertain, the strictness flags and the excludePaths;
# phpstan/extension-installer registers phpstan-typo3, phpat and the other
# PHPStan extensions. phpstan-shared.php includes it only where the package
# is installed, see the comment there.
includes:
    - phpstan-shared.php

parameters:
    paths:
        - ../Classes
    bootstrapFiles:
        - ../.Build/vendor/autoload.php
        - ../Tests/Unit/Bootstrap.php
    scanDirectories:
        - ../Tests/Unit/Fixtures
    ignoreErrors:
        # Both entries below cover ONE expression, the version-safe icon size
        # in Classes/Controller/Backend/TemporalCacheController.php:
        # class_exists(IconSize::class) ? IconSize::SMALL : ICON_SIZE_SMALL_V12.
        # One half of that ternary is always wrong for the TYPO3 version the
        # matrix cell installed, and which half decides which entry fires — so
        # each carries reportUnmatched: false. reportUnmatchedIgnoredErrors
        # itself stays at its default (true), so an ignore that is stale rather
        # than version-conditional is still reported. Drop the lot when v12
        # support is dropped and the ternary goes.
        # The IconSize enum does not exist on every supported version.
        -
            identifier: class.notFound
            message: '#class TYPO3\\CMS\\Core\\Imaging\\IconSize#'
            reportUnmatched: false
        # IconFactory::getIcon() takes an IconSize on the versions that have the
        # enum, so the v12 fallback branch is the wrong argument type there.
        -
            identifier: argument.type
            message: '#method TYPO3\\CMS\\Core\\Imaging\\IconFactory::getIcon\(\) expects TYPO3\\CMS\\Core\\Imaging\\IconSize#'
            reportUnmatched: false
        # method_exists($docHeader, 'setShortcutContext') in the same controller
        # detects v14, which adds the reload and shortcut buttons itself. The
        # method exists on v14 only, so the check is "always true" in the v14
        # cells and "always false" in the v12/v13 cells. Drop both with v13.
        -
            identifier: function.alreadyNarrowedType
            message: '#method_exists\(\) with TYPO3\\CMS\\Backend\\Template\\Components\\DocHeaderComponent and ''setShortcutContext''#'
            reportUnmatched: false
        -
            identifier: function.impossibleType
            message: '#method_exists\(\) with TYPO3\\CMS\\Backend\\Template\\Components\\DocHeaderComponent and ''setShortcutContext''#'
            reportUnmatched: false
